# Copia solo sul Raspberry in /etc/serra-mqtt.env e inserisci i tuoi valori.
# Non pubblicare mai il file compilato.
SERRA_MQTT_HOST=REPLACE_WITH_MQTT_BROKER_IP
SERRA_MQTT_PORT=1883
SERRA_MQTT_USER=REPLACE_WITH_MQTT_USER
SERRA_MQTT_PASS=REPLACE_WITH_MQTT_PASSWORD
SERRA_MQTT_TOPIC=serra
SERRA_CLI=/usr/local/bin/serra
# La password della console è nel file privato creato con serra auth save.
# Trasporto verso la serra. La modalita' Wi-Fi richiede SSH gia' configurato
# e la chiave host verificata in ~/.ssh/known_hosts dell'utente pi.
SERRA_TRANSPORT=uart
# SERRA_SSH_HOST=REPLACE_WITH_GREENHOUSE_LAN_IP
# SERRA_SSH_PORT=22
# Per usare entrambi: SERRA_TRANSPORT=auto e SERRA_PRIMARY_TRANSPORT=wifi|uart.
# Il secondario viene usato solo se il primario fallisce PRIMA del comando.
# SERRA_PRIMARY_TRANSPORT=wifi
# In modalita' Wi-Fi lascia DISABILITATO serra-netoff.timer.
# Opzionale: directory dell'ultima foto sul Raspberry.
# SERRA_FOTO_ARCHIVE=/home/pi/serra/foto
SERRA_UART_LOCK_TIMEOUT=60
SERRA_CMD_TIMEOUT=120
SERRA_MQTT_CONNECT_TIMEOUT=4
